# =============================================================================
# Polymarket Unified SDK — environment variable template
# Copy to .env and fill in. Never commit .env.
# =============================================================================

# ---- Wallet (required for any path that signs) ------------------------------
# The EOA private key that signs L1 EIP-712 + EIP-712 order payloads.
PRIVATE_KEY=0x_your_private_key_here

# The Polymarket Safe proxy wallet address (top-right of polymarket.com UI).
# This is where trading capital lives. NOT the same as the signer EOA address.
FUNDER_ADDRESS=0x_your_funder_address_here

# ---- Live trading gate (required for live submission) -----------------------
# Must be the literal lowercase string "true" to enable live order submission.
# Anything else (including "TRUE", "1", "yes") is treated as false.
# dryRun mode bypasses this gate entirely.
POLYMARKET_ENABLE_LIVE_TRADING=false

# ---- Market selection (required) --------------------------------------------
# Find a slug at polymarket.com/event/<slug>. The default below was active at
# repo creation; if it's resolved/closed by the time you run this, replace it.
MARKET_SLUG="us-x-iran-diplomatic-meeting-by-329"
# Optional: disambiguate when MARKET_SLUG resolves to an event with multiple markets.
# Set exactly one (not both):
CONDITION_ID="0x6fa13f31cceaf10ed3190df6e2aca0a93ab0d6fb46fd279003f17d4cdccee164"
# MARKET_ID=12345

# ---- Order parameters (required) --------------------------------------------
OUTCOME=Yes               # Outcome name (case-insensitive). E.g. "Yes", "No", or candidate name.
SIDE=BUY                  # BUY or SELL.
AMOUNT=1                  # USDC if BUY, shares if SELL. Positive number.
SLIPPAGE_BPS=100          # Optional, defaults to 100 (1%).

# ---- Pre-derived CLOB API credentials (optional, all-or-none) ---------------
# If absent, the SDK derives them on first L2 call via clob.createOrDeriveApiKey().
# CLOB_API_KEY=
# CLOB_SECRET=
# CLOB_PASSPHRASE=
